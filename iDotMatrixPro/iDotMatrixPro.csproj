<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>idmc.ico</ApplicationIcon>
    <RootNamespace>iDotMatrixPro</RootNamespace>
    <AssemblyName>iDotMatrixPro</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="idmc.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
